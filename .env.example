# Witboost AI Toolkit - Environment Configuration
# Copy this file to .env and fill in the values

# Witboost instance base URL (no trailing slash)
WITBOOST_BASE_URL=https://your-witboost-instance.example.com

# Authentication method: "pat" (default) or "sso"
#   pat — uses WITBOOST_TOKEN below (Personal Access Token)
#   sso — opens a browser for SSO login, caches and auto-refreshes the JWT
WITBOOST_AUTH_METHOD=pat

# Personal Access Token — required when WITBOOST_AUTH_METHOD=pat
WITBOOST_TOKEN=your-token-here

# Optional: JWT with Hasura claims for direct GraphQL access to governance/marketplace
# Get this from the browser DevTools (Network tab) when logged into Witboost UI.
# If not set, the toolkit uses the JWT exchanged from the PAT (which may lack Hasura claims).
WITBOOST_HASURA_JWT=

# Optional: Explicit Hasura GraphQL endpoint URL
# If not set, derived from WITBOOST_BASE_URL by replacing the "ui." prefix with "hasura."
# Set this if your Witboost instance uses a non-standard Hasura URL.
WITBOOST_HASURA_URL=
