# Witboost AI Toolkit - Environment Configuration
# Copy this file to .env and fill in the values

# Witboost instance base URL (no trailing slash)
WITBOOST_BASE_URL=https://your-witboost-instance.example.com

# Authentication method: "pat" (default) or "sso"
#   pat — uses WITBOOST_TOKEN below (Personal Access Token)
#   sso — opens a browser for SSO login, caches and auto-refreshes the JWT
WITBOOST_AUTH_METHOD=pat

# Personal Access Token — required when WITBOOST_AUTH_METHOD=pat
WITBOOST_TOKEN=your-token-here

# Optional explicit WCG URL. Needed for Governance tools when WCG is exposed on a separate endpoint.
# If omitted, it is derived from WITBOOST_BASE_URL (ui.* -> wcg.*)
WITBOOST_WCG_URL=https://your-wcg-instance.example.com

# Git provider hostname (bare hostname, no scheme, no trailing slash)
# Default: gitlab.com
# Set this when using a self-hosted GitLab instance.
# Examples: gitlab.mycompany.com  |  gitlab.mycompany.com:8080
#GIT_BASE_URL=gitlab.mycompany.com
